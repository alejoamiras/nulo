{
  "name": "nulo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/extension dev",
    "dev:playground": "bun run --cwd apps/playground dev",
    "dev:landing": "bun run --cwd apps/landing dev",
    "dev:faucet": "bun run --cwd apps/faucet dev",
    "build": "bun run --cwd apps/extension build",
    "build:chrome": "bun run --cwd apps/extension build:chrome",
    "build:firefox": "bun run --cwd apps/extension build:firefox",
    "build:faucet": "bun run --cwd apps/faucet build",
    "test": "bun run --cwd apps/extension test",
    "test:faucet": "bun run --cwd apps/faucet test",
    "test:e2e": "bun run --cwd apps/extension test:e2e",
    "test:e2e:network": "bun run --cwd apps/extension vitest run --config vitest.e2e.network.config.ts",
    "test:e2e:all": "bun run --cwd apps/extension vitest run --config vitest.e2e.all.config.ts",
    "e2e:agent": "bash apps/extension/scripts/e2e/agent.sh",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "lint:actions": "actionlint",
    "format": "biome format --write",
    "check": "biome check",
    "typecheck": "vue-tsc --project apps/extension/tsconfig.json --noEmit",
    "typecheck:all": "bun run --filter '@nulo/*' typecheck",
    "test:all": "bun run --filter '@nulo/*' --if-present test",
    "test:release": "bun test scripts/release/",
    "test:ci-gating": "bun test scripts/ci-cd/",
    "check:imports": "biome check apps/ packages/",
    "audit:vue": "bun run typecheck:all && bun run test && bun run lint && bun run build",
    "audit:faucet": "bun run typecheck:all && bun run test:faucet && bun run lint && bun run --cwd apps/faucet verify:deployments && bun run build:faucet",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2"
  },
  "packageManager": "bun@1.3.14",
  "version": "0.23.0",
  "overrides": {
    "vite": "^8.0.0"
  },
  "patchedDependencies": {
    "@aztec/noir-noirc_abi@5.0.0-rc.2": "patches/@aztec%2Fnoir-noirc_abi@5.0.0-rc.2.patch",
    "@aztec/noir-acvm_js@5.0.0-rc.2": "patches/@aztec%2Fnoir-acvm_js@5.0.0-rc.2.patch"
  }
}
