{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nulo-landing",
	"compatibility_date": "2026-09-01",
	"account_id": "0f1688fc6a4b6acf3fa55cf71e1bed26",
	"assets": {
		"directory": "./dist",
		// Released wallets deep-link to paths with no file here (/forms/uninstall, /forms/feedback):
		// they get index.html with a 200, as on Pages, never a 404.
		"not_found_handling": "single-page-application"
	},
	// nulo.sh is the only production host. Branch previews stay on (Workers Builds uploads one per
	// non-production branch); a preview is a separate version URL, never the production host.
	"routes": [{ "pattern": "nulo.sh", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": true,
	// Privacy Policy § 5.5 lists every request record the Developer can see; Workers Logs is not one.
	"observability": { "enabled": false }
}
