{
	"name": "@nulo/extension",
	"private": true,
	"displayName": "Nulo (V5)",
	"description": "User-friendly self-custody wallet for Aztec network, preserving your privacy and revealing the power of account abstraction.",
	"version": "0.27.0",
	"sentinel": "8",
	"scripts": {
		"check:rp-id": "bun run scripts/check-rp-id.ts",
		"build:full": "bun run build:chrome && bun run build:firefox",
		"build": "bun run check:rp-id && cross-env NODE_OPTIONS=--max-old-space-size=16000 vite build -c vite.chrome.config.mts",
		"build:chrome": "bun run check:rp-id && cross-env NODE_OPTIONS=--max-old-space-size=16000 vite build -c vite.chrome.config.mts",
		"build:firefox": "bun run check:rp-id && cross-env NODE_OPTIONS=--max-old-space-size=16000 vite build -c vite.firefox.config.mts",
		"dev:full": "concurrently \"bun run dev:chrome\" \"bun run dev:firefox\"",
		"dev": "vite -c vite.chrome.config.mts",
		"dev:chrome": "vite -c vite.chrome.config.mts",
		"dev:firefox": "vite build --mode development --watch -c vite.firefox.config.mts",
		"preview": "vite preview",
		"lint": "biome check src/",
		"lint:fix": "biome check src/ --fix",
		"format": "biome format src/ --write",
		"check": "biome check src/",
		"typecheck": "vue-tsc --noEmit",
		"test": "vitest run",
		"test:components": "vitest run src/components",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"test:e2e:all": "vitest run --config vitest.e2e.all.config.ts",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"@alejoamiras/aztec-accelerator": "5.0.1",
		"@aztec/accounts": "5.0.1",
		"@aztec/aztec.js": "5.0.1",
		"@aztec/bb.js": "5.0.1",
		"@aztec/constants": "5.0.1",
		"@aztec/entrypoints": "5.0.1",
		"@aztec/foundation": "5.0.1",
		"@aztec/kv-store": "5.0.1",
		"@aztec/noir-acvm_js": "5.0.1",
		"@aztec/noir-contracts.js": "5.0.1",
		"@aztec/noir-noirc_abi": "5.0.1",
		"@aztec/protocol-contracts": "5.0.1",
		"@aztec/pxe": "5.0.1",
		"@aztec/simulator": "5.0.1",
		"@aztec/stdlib": "5.0.1",
		"@aztec/wallet-sdk": "5.0.1",
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.10.3",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/language": "^6.12.3",
		"@codemirror/search": "^6.7.1",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.1",
		"@aztec-foundation/aztec-standards": "5.0.1",
		"@lezer/highlight": "^1.2.3",
		"@nulo/aztec-runtime": "workspace:*",
		"@nulo/bridge-core": "workspace:*",
		"@nulo/design": "workspace:*",
		"@nulo/extension-messaging": "workspace:*",
		"@nulo/wallet-bridge": "workspace:*",
		"@nulo/wallet-core": "workspace:*",
		"@nulo/wallet-crypto": "workspace:*",
		"@nulo/wallet-sdk-schema-patch": "workspace:*",
		"@replit/codemirror-indentation-markers": "^6.5.3",
		"@alejoamiras/private-fee-juice": "5.0.1",
		"codemirror": "^6.0.2",
		"focus-trap": "^8.2.1",
		"lean-qr": "^2.7.1",
		"luxon": "^3.7.2",
		"pako": "^2.1.0",
		"pinia": "^3.0.4",
		"vue": "^3.5.38",
		"vue-router": "^5.1.0",
		"webextension-polyfill": "^0.12.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@aztec/ethereum": "5.0.1",
		"@aztec/l1-artifacts": "5.0.1",
		"@aztec/viem": "2.38.2",
		"@aztec/wallets": "5.0.1",
		"@crxjs/vite-plugin": "^2.6.1",
		"@pinia/testing": "^1.0.3",
		"@storybook/vue3-vite": "^10.4.6",
		"@types/node": "^24.13.2",
		"@types/webextension-polyfill": "^0.12.5",
		"@vitejs/plugin-vue": "^6.0.7",
		"@vue/compiler-sfc": "^3.5.38",
		"@vue/test-utils": "^2.4.11",
		"@webext-core/fake-browser": "^1.5.2",
		"chrome-types": "^0.1.429",
		"concurrently": "^10.0.3",
		"cross-env": "^10.1.0",
		"fast-check": "^4.9.0",
		"globals": "^17.6.0",
		"jsdom": "^29.1.1",
		"postcss": "^8.5.15",
		"puppeteer": "^25.1.0",
		"sass": "^1.101.0",
		"storybook": "^10.4.6",
		"typescript": "^6.0.3",
		"unplugin-auto-import": "^21.0.0",
		"unplugin-vue-components": "^32.1.0",
		"vite": "^8.0.16",
		"vite-plugin-node-polyfills": "^0.28.0",
		"vite-plugin-pages": "^0.33.3",
		"vite-plugin-static-copy": "^4.1.1",
		"vitest": "^4.1.9",
		"vue-tsc": "^3.3.5",
		"webext-bridge": "^6.0.1"
	}
}
