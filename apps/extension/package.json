{
	"name": "@nulo/extension",
	"private": true,
	"displayName": "Nulo V6",
	"description": "A wallet for Aztec: your balance and payments stay private unless you decide otherwise. Your keys stay on your device.",
	"version": "0.30.0",
	"license": "Apache-2.0",
	"scripts": {
		"check:rp-id": "bun run scripts/check-rp-id.ts",
		"build:full": "bun run build:chrome && bun run build:firefox",
		"build": "bun run check:rp-id && cross-env NODE_OPTIONS=--max-old-space-size=16000 vite build -c vite.chrome.config.mts",
		"build:chrome": "bun run check:rp-id && cross-env NODE_OPTIONS=--max-old-space-size=16000 vite build -c vite.chrome.config.mts",
		"build:firefox": "bun run check:rp-id && cross-env NODE_OPTIONS=--max-old-space-size=16000 vite build -c vite.firefox.config.mts",
		"dev:full": "bun run --parallel dev:chrome dev:firefox",
		"dev": "vite -c vite.chrome.config.mts",
		"dev:chrome": "vite -c vite.chrome.config.mts",
		"dev:firefox": "vite build --mode development --watch -c vite.firefox.config.mts",
		"preview": "vite preview",
		"lint": "biome check src/",
		"lint:fix": "biome check src/ --fix",
		"format": "biome format src/ --write",
		"check": "biome check src/",
		"typecheck": "vue-tsc --noEmit",
		"test": "bun --bun vitest run",
		"test:components": "bun --bun vitest run src/components",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"test:e2e:all": "vitest run --config vitest.e2e.all.config.ts",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"@alejoamiras/presto": "6.0.0-rc.1",
		"@alejoamiras/presto-banners": "1.1.0",
		"@alejoamiras/presto-core": "1.2.1",
		"@aztec-labs/accounts": "6.0.0-rc.1",
		"@aztec-labs/aztec.js": "6.0.0-rc.1",
		"@aztec-foundation/bb.js": "6.0.0-rc.1",
		"@aztec-labs/constants": "6.0.0-rc.1",
		"@aztec-labs/entrypoints": "6.0.0-rc.1",
		"@aztec-labs/foundation": "6.0.0-rc.1",
		"@aztec-labs/kv-store": "6.0.0-rc.1",
		"@aztec-foundation/noir-acvm_js": "6.0.0-rc.1",
		"@aztec-labs/noir-contracts.js": "6.0.0-rc.1",
		"@aztec-foundation/noir-noirc_abi": "6.0.0-rc.1",
		"@aztec-labs/protocol-contracts": "6.0.0-rc.1",
		"@aztec-labs/pxe": "6.0.0-rc.1",
		"@aztec-labs/simulator": "6.0.0-rc.1",
		"@aztec-labs/sqlite3mc-wasm": "6.0.0-rc.1",
		"@aztec-labs/standard-contracts": "6.0.0-rc.1",
		"@aztec-labs/stdlib": "6.0.0-rc.1",
		"@aztec-labs/wallet-sdk": "6.0.0-rc.1",
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.10.3",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/language": "^6.12.3",
		"@codemirror/search": "^6.7.1",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.1",
		"@aztec-foundation/aztec-standards": "6.0.0-rc.1",
		"@lezer/highlight": "^1.2.3",
		"@nulo/aztec-runtime": "workspace:*",
		"@nulo/design": "workspace:*",
		"@nulo/extension-messaging": "workspace:*",
		"@nulo/legal": "workspace:*",
