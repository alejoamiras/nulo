# Copy this to .env.local (gitignored) and fill in real values.
# .env.local is loaded by bun for both the dev server (VITE_* keys) and
# the deploy script (DEPLOYER_*, AZTEC_NODE_URL keys).

# ─── Deploy-only (used by scripts/deploy.ts; never sent to the browser) ────

# Option A — hex Fr pair (recommended if you already have a funded
# testnet account, e.g. shared with another project on this machine):
DEPLOYER_SECRET_KEY=0x...   # 0x + 64 hex chars; Fr field element
DEPLOYER_SALT=0x...         # 0x + 64 hex chars; Fr field element

# Option B — utf8 string (derives a fresh account; only useful for a
# brand-new deploy you control end-to-end):
# DEPLOYER_SECRET=at-least-32-character-passphrase

# Override the default per-network RPC if you need to point at a fork.
# The default for --network testnet is https://v5.testnet.rpc.aztec-labs.com.
# AZTEC_NODE_URL=https://your-own-rpc

# ─── Frontend (Vite-prefixed; safe to ship in the browser bundle) ─────────

VITE_AZTEC_NODE_URL=https://v5.testnet.rpc.aztec-labs.com
VITE_EXPLORER_BASE_URL=https://testnet.aztecscan.xyz

# The wallet-sdk discovery chain identity (L1 chainId + rollup version) is a
# hardcoded constant in src/lib/chain-constants.ts — there is deliberately NO
# VITE_CHAIN_* override. A stale value here (this file once shipped the old
# 4127419662) silently broke the wallet handshake in prod ("No network
# configured for chainId 4138294185"). The faucet is testnet-only; change the
# constant in code, not via env.

# Where the "Install Nulo" CTA points when no wallet is detected.
# VITE_NULO_INSTALL_URL=https://chromewebstore.google.com/detail/...
