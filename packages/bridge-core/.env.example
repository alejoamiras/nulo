# Copy this to .env (gitignored) — read by the bridge-core deploy/smoke/canary
# scripts (deploy-generation, smoke-existing-testnet, smoke-swap-existing-testnet,
# fuel-testnet, verify-l1, check-fpc-version) and by forge via vm.envUint
# (DeployFuelLive / DeployBridge).

# Required for anything that signs — L1 forge broadcasts, the fueled candidate
# smoke, the fuel canary. The Sepolia deployer EOA; never commit a real value.
PRIVATE_KEY=0x...

# Required for L1 reads/broadcasts. Scripts fall back to the public Sepolia node
# for reads — use your own endpoint for anything that broadcasts.
SEPOLIA_RPC_URL=https://...

# Required by the Sepolia FORK suites (FactoryFork, SwapBridgeRouterPermit2Fork): the
# network's canonical Aztec registry. Absent ⇒ those suites skip.
# AZTEC_REGISTRY=0x...

# Optional — defaults shown; uncomment to override.
# AZTEC_NODE_URL=https://v5.testnet.rpc.aztec-labs.com
# ETHERSCAN_API_KEY=          # forge verify only
# FORGE_BIN=forge             # only if forge is not on PATH (else PATH, then ~/.aztec/current/bin/forge)
# CAST_BIN=cast               # else ~/.aztec/current/internal-bin/cast, the 5.0.0 pin, then PATH

# Per-run knobs (FUEL_ROUTER, FUEL_SWAP, TOKEN_ADDRESS, ROUTER_ADDRESS,
# FUEL_SWAP_ADDRESS, SEED_*, PRIVATE_RUNS, …) are passed per invocation —
# see .claude/skills/aztec-update/SKILL.md Branch B. Don't persist them here.
