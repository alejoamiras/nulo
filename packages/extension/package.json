{
	"name": "@nulo/extension",
	"private": true,
	"displayName": "Nulo",
	"description": "User-friendly self-custody wallet for Aztec network, preserving your privacy and revealing the power of account abstraction.",
	"version": "0.20.2",
	"sentinel": "7",
	"scripts": {
		"check:rp-id": "bun run scripts/check-rp-id.ts",
		"build:full": "bun run build:chrome && bun run build:firefox",
		"build": "bun run check:rp-id && cross-env NODE_OPTIONS=--max-old-space-size=16000 vite build -c vite.chrome.config.mts",
		"build:chrome": "bun run check:rp-id && cross-env NODE_OPTIONS=--max-old-space-size=16000 vite build -c vite.chrome.config.mts",
		"build:firefox": "bun run check:rp-id && cross-env NODE_OPTIONS=--max-old-space-size=16000 vite build -c vite.firefox.config.mts",
		"dev:full": "concurrently \"bun run dev:chrome\" \"bun run dev:firefox\"",
		"dev": "vite -c vite.chrome.config.mts",
		"dev:chrome": "vite -c vite.chrome.config.mts",
		"dev:firefox": "vite build --mode development --watch -c vite.firefox.config.mts",
		"preview": "vite preview",
		"lint": "biome check src/",
		"lint:fix": "biome check src/ --fix",
		"format": "biome format src/ --write",
		"check": "biome check src/",
		"typecheck": "vue-tsc --noEmit",
		"test": "vitest",
		"test:components": "vitest run src/components",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"test:e2e:all": "vitest run --config vitest.e2e.all.config.ts",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"@alejoamiras/aztec-accelerator": "4.2.0",
		"@aztec/accounts": "4.2.0",
		"@aztec/aztec.js": "4.2.0",
		"@aztec/bb.js": "4.2.0",
		"@aztec/constants": "4.2.0",
		"@aztec/entrypoints": "4.2.0",
		"@aztec/foundation": "4.2.0",
		"@aztec/kv-store": "4.2.0",
		"@aztec/noir-acvm_js": "4.2.0",
		"@aztec/noir-contracts.js": "4.2.0",
		"@aztec/noir-noirc_abi": "4.2.0",
		"@aztec/protocol-contracts": "4.2.0",
		"@aztec/pxe": "4.2.0",
		"@aztec/simulator": "4.2.0",
		"@aztec/stdlib": "4.2.0",
		"@aztec/wallet-sdk": "4.2.0",
		"@codemirror/autocomplete": "^6.0.0",
		"@codemirror/commands": "^6.0.0",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/language": "^6.0.0",
		"@codemirror/search": "^6.0.0",
		"@codemirror/state": "^6.0.0",
		"@codemirror/view": "^6.0.0",
		"@defi-wonderland/aztec-standards": "4.2.0-aztecnr-rc.2",
		"@lezer/highlight": "^1.0.0",
		"@nulo/aztec-runtime": "workspace:*",
		"@nulo/extension-messaging": "workspace:*",
		"@nulo/wallet-bridge": "workspace:*",
		"@nulo/wallet-core": "workspace:*",
		"@nulo/wallet-crypto": "workspace:*",
		"@replit/codemirror-indentation-markers": "^6.5.3",
		"@wonderland/aztec-fee-payment": "https://github.com/defi-wonderland/aztec-fee-payment/releases/download/prerelease-215fd08/wonderland-aztec-fee-payment-4.2.0-prerelease.215fd08.tgz",
		"codemirror": "^6.0.2",
		"focus-trap": "^8.0.0",
		"lean-qr": "^2.5.0",
		"pako": "^2.1.0",
		"luxon": "^3.7.1",
		"pinia": "^3.0.3",
		"vue": "^3.5.18",
		"vue-router": "^5.0.5",
		"webextension-polyfill": "^0.12.0",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@aztec/ethereum": "4.2.0",
		"@aztec/l1-artifacts": "4.2.0",
		"@aztec/viem": "2.38.2",
		"@aztec/wallets": "4.2.0",
		"@crxjs/vite-plugin": "^2.1.0",
		"@pinia/testing": "^1.0.3",
		"@storybook/vue3-vite": "^10.3.5",
		"@types/node": "^24.2.1",
		"@types/webextension-polyfill": "^0.12.3",
		"@vitejs/plugin-vue": "^6.0.1",
		"@vue/compiler-sfc": "^3.5.18",
		"@vue/test-utils": "^2.4.9",
		"@webext-core/fake-browser": "^1.3.4",
		"chrome-types": "^0.1.370",
		"concurrently": "^9.2.0",
		"cross-env": "^10.0.0",
		"globals": "^17.6.0",
		"jsdom": "^29.1.1",
		"postcss": "^8.5.6",
		"puppeteer": "^25.0.0",
		"sass": "^1.90.0",
		"storybook": "^10.3.5",
		"typescript": "^6.0.3",
		"unplugin-auto-import": "^21.0.0",
		"unplugin-vue-components": "^32.0.0",
		"vite": "^8.0.11",
		"vite-plugin-node-polyfills": "^0.26.0",
		"vite-plugin-pages": "^0.33.1",
		"vite-plugin-static-copy": "^4.1.0",
		"vite-plugin-vue-devtools": "^8.0.0",
		"vitest": "^4.1.5",
		"vue-tsc": "^3.0.5",
		"webext-bridge": "^6.0.1"
	}
}
