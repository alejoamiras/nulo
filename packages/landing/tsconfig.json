{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["vite/client", "vitest/globals"]
	},
	"include": ["src/**/*.ts", "scripts/**/*.ts", "vite.config.ts"]
}
