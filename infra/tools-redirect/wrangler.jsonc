{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nulo-tools-redirect",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-01",
	"account_id": "0f1688fc6a4b6acf3fa55cf71e1bed26",
	// Reachable only at the two old tools names: no workers.dev origin, no preview URLs.
	"workers_dev": false,
	"preview_urls": false,
	// Cloudflare refuses a Custom Domain over a record Pages still holds: the first upload runs with
	// these routes commented out, and they return once the names are detached from Pages.
	"routes": [{ "pattern": "tools.nulo.sh", "custom_domain": true }, { "pattern": "testnet.tools.nulo.sh", "custom_domain": true }]
}
