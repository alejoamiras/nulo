{
	"name": "@nulo/tools-redirect",
	"version": "0.0.0",
	"license": "Apache-2.0",
	"private": true,
	"type": "module",
	"description": "Redirects the retired tools hostnames (tools.nulo.sh, testnet.tools.nulo.sh) to the tools app's new home.",
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "bun test",
		"deploy": "wrangler deploy",
		"deploy:dry": "wrangler deploy --dry-run --outdir dist",
		"test:live": "TOOLS_REDIRECT_LIVE=1 bun test test/live.test.ts"
	},
	"devDependencies": {
		"typescript": "^6.0.3",
		"wrangler": "4.129.1"
	}
}
