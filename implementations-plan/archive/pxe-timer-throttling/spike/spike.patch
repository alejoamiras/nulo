new file mode 100644
index 00000000..d25e340f
--- /dev/null
+++ b/apps/extension/src/offscreen/timer-probe.ts
@@ -0,0 +1,182 @@
+// SPIKE ONLY — never ships. Armed by VITE_NULO_SPIKE_TIMERS=probe|shim at build time.
+//   probe: wraps the page's timers and records, per call site, how late each one fired.
+//   shim:  same recording, but every timer is scheduled on a dedicated worker instead.
+// Must be the first import of the offscreen entry so every later module sees the wrapped globals.
+import TimerWorker from "./timer-probe.worker?worker"
+
+type Mode = "probe" | "shim"
+const mode = import.meta.env.VITE_NULO_SPIKE_TIMERS as Mode | undefined
+
+interface Site {
+	n: number
+	requestedMs: number
+	lateMs: number
+	maxLateMs: number
+}
+
+const SHIM_ID_BASE = 1_000_000_000
+const MAX_STACKS = 50_000
+
+function arm(armed: Mode): void {
+	const nativeSet = self.setTimeout.bind(self)
+	const nativeClear = self.clearTimeout.bind(self)
+	let sites = new Map<string, Site>()
+	let scheduledBySite = new Map<string, number>()
+	let total = 0
+	let stacks = 0
+
+	const worker = new TimerWorker()
+	const pending = new Map<number, () => void>()
+	let nextId = SHIM_ID_BASE
+	worker.onmessage = (event: MessageEvent<number>) => {
+		const run = pending.get(event.data)
+		if (!run) return
+		pending.delete(event.data)
+		run()
+	}
+	const workerSet = (run: () => void, delay: number): number => {
+		const id = nextId++
+		pending.set(id, run)
+		worker.postMessage({ id, delay })
+		return id
+	}
+	const workerClear = (id: number): void => {
+		if (pending.delete(id)) worker.postMessage({ id, clear: true })
+	}
+
+	const siteOf = (): string => {
+		if (stacks++ > MAX_STACKS) return "(stack budget spent)"
+		// The first two frames are this probe (siteOf + the wrapper); a minified bundle leaves no
+		// file name to filter them by.
+		const lines = (new Error().stack ?? "").split("\n").filter((line) => line.trim() !== "" && line.trim() !== "Error")
+		return lines
+			.slice(2, 7)
+			.map((line) =>
+				line
+					.trim()
+					.replace(/^at /, "")
+					.replace(/(moz|chrome)-extension:\/\/[^/]+\//g, ""),
+			)
+			.join(" < ")
+	}
+
+	const record = (site: string, requested: number, startedAt: number): void => {
+		const late = Math.max(0, performance.now() - startedAt - requested)
+		const entry = sites.get(site) ?? { n: 0, requestedMs: 0, lateMs: 0, maxLateMs: 0 }
+		entry.n++
+		entry.requestedMs += requested
+		entry.lateMs += late
+		entry.maxLateMs = Math.max(entry.maxLateMs, late)
+		sites.set(site, entry)
+	}
+
+	const schedule = (run: () => void, delay: number): number => (armed === "shim" ? workerSet(run, delay) : (nativeSet(run, delay) as unknown as number))
+
+	const wrappedSetTimeout = (handler: TimerHandler, delay?: number, ...args: unknown[]): number => {
+		const requested = Math.max(0, Number(delay) || 0)
+		const site = siteOf()
+		const startedAt = performance.now()
+		total++
+		scheduledBySite.set(site, (scheduledBySite.get(site) ?? 0) + 1)
+		return schedule(() => {
+			record(site, requested, startedAt)
+			if (typeof handler === "function") handler(...args)
+		}, requested)
+	}
+
+	const intervals = new Map<number, number>()
+	const wrappedSetInterval = (handler: TimerHandler, delay?: number, ...args: unknown[]): number => {
+		const requested = Math.max(0, Number(delay) || 0)
+		const site = `[interval] ${siteOf()}`
+		const key = nextId++
+		const tick = (): void => {
+			const startedAt = performance.now()
+			total++
+			intervals.set(
+				key,
+				schedule(() => {
+					if (!intervals.has(key)) return
+					record(site, requested, startedAt)
+					tick()
+					if (typeof handler === "function") handler(...args)
+				}, requested),
+			)
+		}
+		tick()
+		return key
+	}
+
+	const wrappedClear = (id?: number): void => {
+		if (id === undefined) return
+		const inner = intervals.get(id)
+		if (inner !== undefined) {
+			intervals.delete(id)
+			wrappedClear(inner)
+			return
+		}
+		if (id >= SHIM_ID_BASE) workerClear(id)
+		else nativeClear(id)
+	}
+
+	Object.assign(self, { setTimeout: wrappedSetTimeout, clearTimeout: wrappedClear, setInterval: wrappedSetInterval, clearInterval: wrappedClear })
+
+	const chain = async (hop: () => Promise<void>, hops: number): Promise<number> => {
+		const startedAt = performance.now()
+		for (let i = 0; i < hops; i++) await hop()
+		return (performance.now() - startedAt) / hops
+	}
+	const selfTest = async () => {
+		const channel = new MessageChannel()
+		const viaChannel = () =>
+			new Promise<void>((resolve) => {
+				channel.port1.onmessage = () => resolve()
+				channel.port2.postMessage(0)
+			})
+		return {
+			nativeZeroMs: await chain(() => new Promise<void>((resolve) => void nativeSet(resolve, 0)), 5),
+			nativeFiftyMs: await chain(() => new Promise<void>((resolve) => void nativeSet(resolve, 50)), 5),
+			workerZeroMs: await chain(() => new Promise<void>((resolve) => void workerSet(resolve, 0)), 5),
+			workerFiftyMs: await chain(() => new Promise<void>((resolve) => void workerSet(resolve, 50)), 5),
+			messageChannelMs: await chain(viaChannel, 50),
+		}
+	}
+
+	chrome.runtime.onMessage.addListener((message: unknown, _sender, sendResponse) => {
+		const request = message as { type?: string; reset?: boolean; selfTest?: boolean } | null
+		if (request?.type !== "NULO_SPIKE_TIMER_DUMP") return false
+		const top = [...sites.entries()]
+			.sort((a, b) => b[1].lateMs - a[1].lateMs)
+			.slice(0, 25)
+			.map(([site, s]) => ({ site, ...s, requestedMs: Math.round(s.requestedMs), lateMs: Math.round(s.lateMs), maxLateMs: Math.round(s.maxLateMs) }))
+		const snapshot = {
+			mode: armed,
+			visibility: document.visibilityState,
+			hasFocus: document.hasFocus(),
+			framed: window.top !== window,
+			timeOrigin: Math.round(performance.timeOrigin),
+			instance: new URLSearchParams(location.search).get("instance"),
+			crossOriginIsolated: self.crossOriginIsolated,
+			timers: total,
+			distinctSites: sites.size,
+			totalLateMs: Math.round([...sites.values()].reduce((sum, s) => sum + s.lateMs, 0)),
+			top,
+			topScheduled: [...scheduledBySite.entries()]
+				.sort((a, b) => b[1] - a[1])
+				.slice(0, 12)
+				.map(([site, n]) => ({ site, n })),
+		}
+		if (request.reset) {
+			sites = new Map()
+			scheduledBySite = new Map()
+			total = 0
+		}
+		if (!request.selfTest) {
+			sendResponse(snapshot)
+			return false
+		}
+		void selfTest().then((result) => sendResponse({ ...snapshot, selfTest: result }))
+		return true
+	})
+}
+
+if (mode === "probe" || mode === "shim") arm(mode)
diff --git a/apps/extension/src/offscreen/timer-probe.worker.ts b/apps/extension/src/offscreen/timer-probe.worker.ts
new file mode 100644
index 00000000..b1153c93
--- /dev/null
+++ b/apps/extension/src/offscreen/timer-probe.worker.ts
@@ -0,0 +1,20 @@
+// SPIKE ONLY — never ships. Timers owned by a dedicated worker, to measure whether they escape
+// the background-window clamp that applies to the owning page's main thread.
+const live = new Map<number, ReturnType<typeof setTimeout>>()
+
+self.onmessage = (event: MessageEvent<{ id: number; delay?: number; clear?: boolean }>) => {
+	const { id, delay, clear } = event.data
+	if (clear) {
+		const handle = live.get(id)
+		if (handle !== undefined) clearTimeout(handle)
+		live.delete(id)
+		return
+	}
+	live.set(
+		id,
+		setTimeout(() => {
+			live.delete(id)
+			self.postMessage(id)
+		}, delay ?? 0),
+	)
+}
