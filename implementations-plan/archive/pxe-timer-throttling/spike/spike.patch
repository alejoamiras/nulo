@@ -0,0 +1,52 @@
+// SPIKE ONLY — never ships. Answers one message with how long the background's own timers take,
+// to tell whether the background context is throttled like the minimized PXE window is.
+if (import.meta.env.VITE_NULO_SPIKE_TIMERS) {
+	const chain = async (delay: number, hops: number): Promise<number> => {
+		const startedAt = performance.now()
+		for (let i = 0; i < hops; i++) await new Promise<void>((resolve) => void setTimeout(resolve, delay))
+		return (performance.now() - startedAt) / hops
+	}
+	// The sender shape the PXE host's READY arrives with — what sender auth must accept.
+	let readySender: Record<string, unknown> | null = null
+	chrome.runtime.onMessage.addListener((message: unknown, sender) => {
+		if (message !== "OFFSCREEN_READY") return false
+		readySender = {
+			keys: Object.keys(sender).sort(),
+			url: sender.url?.replace(/^moz-extension:\/\/[^/]+/, "moz-extension://<uuid>"),
+			hasTab: sender.tab !== undefined,
+			frameId: sender.frameId ?? null,
+			idMatches: sender.id === chrome.runtime.id,
+			origin: (sender as { origin?: string }).origin ?? null,
+		}
+		return false
+	})
+	chrome.runtime.onMessage.addListener((message: unknown, _sender, sendResponse) => {
+		if ((message as { type?: string } | null)?.type !== "NULO_SPIKE_BG_SELFTEST") return false
+		void (async () => {
+			const spike = (
+				globalThis as { __nuloSpike?: { runtime: { start(): Promise<void> }; logger: { get(count: number): unknown[] } } }
+			).__nuloSpike
+			const boot = spike
+				? await Promise.race([
+						spike.runtime.start().then(
+							() => "started",
+							(error: unknown) => `failed: ${String(error).slice(0, 300)}`,
+						),
+						new Promise<string>((resolve) => void setTimeout(() => resolve("pending after 5s"), 5_000)),
+					])
+				: "no-handle"
+			const logs = (spike?.logger.get(60) ?? []).map((entry) => JSON.stringify(entry).slice(0, 260))
+			sendResponse({
+				boot,
+				logs,
+				context: typeof document === "undefined" ? "service-worker" : `page:${document.visibilityState}`,
+				timeOrigin: Math.round(performance.timeOrigin),
+				frames: typeof document === "undefined" ? 0 : document.querySelectorAll("iframe").length,
+				readySender,
+				nativeZeroMs: await chain(0, 5),
+				nativeFiftyMs: await chain(50, 5),
+			})
+		})()
+		return true
+	})
+}
